{"id": "awesome-poc:cve-2020-11455", "kind": "poc", "title": "LimeSurvey LimeSurveyFileManager.php 后台任意文件读取漏洞 CVE-2020-11455", "technique": "path-traversal", "summary": "Web应用漏洞 / CVE-2020-11455。载荷取自 Awesome-POC 的复现段落，已按实例值参数化。", "preconditions": ["目标产品与版本需落在 CVE-2020-11455 的影响范围内（先确认版本，再发载荷）", "载荷中的 {{host}} / {{target_url}} 按实际目标替换"], "target_stack": ["Web应用漏洞", "CVE-2020-11455"], "payload_template": "public function downloadFiles() {\n        App()->loadLibrary('admin.pclzip');\n        \n        $folder = basename(Yii::app()->request->getPost('folder', 'global'));\n        $files = Yii::app()->request->getPost('files');\n\n        $tempdir = Yii::app()->getConfig('tempdir');\n        $randomizedFileName = $folder.'_'.substr(md5(time()),3,13).'.zip';\n        $zipfile = $tempdir.DIRECTORY_SEPARATOR.$randomizedFileName;\n        $arrayOfFiles = array_map( function($file){ return $file['path']; }, $files);\n        $archive = new PclZip($zipfile);\n        $checkFileCreate = $archive->create($arrayOfFiles, PCLZIP_OPT_REMOVE_ALL_PATH);\n        $urlFormat = Yii::app()->getUrlManager()->getUrlFormat();\n        $getFileLink = Yii::app()->createUrl('admin/filemanager/sa/getZipFile');\n        if($urlFormat == 'path') {\n            $getFileLink .= '?path='.$zipfile;\n        } else {\n            $getFileLink .= '&path='.$zipfile;\n        }\n\n        $this->_printJsonResponse(\n            [\n                'success' => true,\n                'message' => sprintf(gT(\"Files are ready for download in archive %s.\"), $randomizedFileName),\n                'downloadLink' => $getFileLink ,\n            ]\n        );\n    }", "verification_method": ["按 payload 原样发送；命中判据是响应出现该 CVE 的预期特征（回显、报错或读到的文件内容）。", "第一次没有预期响应时换下一条载荷，不要在同一句上反复微调。"], "known_failures": ["机制导入，从未在本平台靶机上验证过；版本不符时不会生效。"], "steps": ["确认目标版本在 CVE-2020-11455 影响范围内", "把 payload 中的占位符换成实际目标", "发送并把响应与预期特征比对"], "post_exploitation": ["先确认读得通：`/etc/passwd` 能出内容再往下，否则换编码（`..%2f`、`..%252f`、`....//`）。", "直接冲 flag 的