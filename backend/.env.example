APP_DATABASE_URL=mysql+asyncmy://ctf_agent:ctf_agent@localhost:3307/ctf_agent
APP_WORKSPACE_ROOT=../data/workspaces
# The legacy Kali Runner is retired; tools execute in container-native Workers.
# Set to 1 only for a deployment that still fronts a standalone Runner, in which
# case readiness and the tool manifest will gate on it again.
APP_LEGACY_KALI_RUNNER=0
APP_RUNNER_URL=http://192.168.236.128:8091
APP_RUNNER_API_TOKEN=replace-with-the-runner-token
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENCRYPTION_KEY=replace-with-a-managed-secret
APP_ALLOWED_SERVICE_CIDRS=127.0.0.0/8,192.168.56.0/24,192.168.236.0/24
